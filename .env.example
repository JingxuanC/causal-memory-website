# Auth.js
AUTH_SECRET=            # openssl rand -base64 32
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# AUTH_URL=https://your-domain.com   # production only

# Comma-separated emails allowed to publish blog posts from /dashboard
ADMIN_EMAILS=

# Database (SQLite default; use Postgres in production)
DATABASE_URL=file:./dev.db

# BYOK key encryption (any string; sha256-derived AES-256-GCM key)
BYOK_SECRET=

# Book-chapter AI chat (OpenAI-compatible endpoint). Optional — without
# AI_API_KEY, chat falls back to each signed-in user's own BYOK key.
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=

# ---- Alpha Desk product page ----
# Path to the release zip inside the container (mounted from ./data), or a CDN URL.
ALPHA_DESK_ZIP_PATH=/app/data/alpha-desk-0.1.2-dev.zip
ALPHA_DESK_SKILL_PATH=/app/data/alpha-desk-install-skill.zip
# ALPHA_DESK_DOWNLOAD_URL=https://cdn.example.com/alpha-desk-0.1.2-dev.zip

# Offline license signing. Use the private half of Alpha Desk's license keypair.
# Mount it read-only; never commit it.
ALPHA_LICENSE_PRIVATE_KEY_PATH=/app/secrets/alpha-license-private.pem
ALPHA_LICENSE_PUBLIC_KEY_PATH=/app/secrets/alpha-license-public.pem
ALPHA_LICENSE_DAYS=365

# quota-platform apply API (existing key-request proxy default)
# KEY_REQUEST_UPSTREAM=http://127.0.0.1:3300/api/apply

# ---- Cloud memory bridge (Alpha Desk Pro -> /memory/mcp) ----
# Writable path to causal-memory's tokens/cloud.json. The website writes only
# SHA-256 hashes there, atomically and under a lock. If this is unset, token
# creation and Pro claims fail closed (503) instead of issuing dead tokens.
CM_TOKENS_BRIDGE=/opt/mcp-suite/causal-memory/tokens/cloud.json

# HMAC secret shared with quota-platform. Pro apply/pickup calls carry a signed
# user identity so the public /quota/api/apply/<reqNo>/pickup endpoint cannot
# be used without the website session. Must match quota-platform's env.
ALPHA_CLAIM_SECRET=

# Direct memory endpoint embedded in new licenses (new Alpha Desk clients).
MEMORY_PUBLIC_URL=https://causal-memory.com/memory/mcp
