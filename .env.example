# Auth.js
AUTH_SECRET=            # openssl rand -base64 32
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# AUTH_URL=https://your-domain.com   # production only

# Comma-separated emails allowed to publish blog posts from /dashboard
ADMIN_EMAILS=

# Database (SQLite default; use Postgres in production)
DATABASE_URL=file:./dev.db

# BYOK key encryption (any string; sha256-derived AES-256-GCM key)
BYOK_SECRET=

# Book-chapter AI chat (OpenAI-compatible endpoint). Optional — without
# AI_API_KEY, chat falls back to each signed-in user's own BYOK key.
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=
